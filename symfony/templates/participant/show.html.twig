{% extends 'base.html.twig' %}

{% block title %}Participant{% endblock %}

{% block body %}
    <h1>Participant</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ participant.id }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ participant.lastName }}</td>
            </tr>
            <tr>
                <th>First_name</th>
                <td>{{ participant.firstName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ participant.email }}</td>
            </tr>
            <tr>
                <th>Qr_code</th>
                <td>{{ participant.qrCode }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ participant.country }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ participant.photo }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ participant.createdAt ? participant.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ participant.updatedAt ? participant.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Created_by</th>
                <td>{{ participant.createdBy }}</td>
            </tr>
            <tr>
                <th>Participant_type_id</th>
                <td>{{ participant.participantTypeId }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_participant_index') }}">back to list</a>

    <a href="{{ path('app_participant_edit', {'id': participant.id}) }}">edit</a>

    {{ include('participant/_delete_form.html.twig') }}
{% endblock %}
