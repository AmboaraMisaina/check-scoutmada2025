{% extends 'base.html.twig' %}

{% block title %}Gestion des Organisations{% endblock %}

{% block body %}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Organisations</h1>
        <a href="{{ path('app_organization_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i> Créer une Organisation
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Créée le</th>
                            <th>Modifiée le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for organization in organizations %}
                        <tr>
                            <td>{{ organization.id }}</td>
                            <td class="fw-bold">{{ organization.name }}</td>
                            {# Utilisation d'un filtre pour tronquer la description si elle est trop longue #}
                            <td>{{ organization.description | length > 50 ? organization.description|slice(0, 50) ~ '...' : organization.description }}</td>
                            
                            {# Formatage des dates pour la lisibilité #}
                            <td>{{ organization.createdAt ? organization.createdAt|date('d/m/Y H:i') : '' }}</td>
                            <td>{{ organization.updatedAt ? organization.updatedAt|date('d/m/Y H:i') : '' }}</td>
                            
                            <td class="d-flex gap-2">
                                <a href="{{ path('app_organization_show', {'id': organization.id}) }}" class="btn btn-sm btn-info" title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_organization_edit', {'id': organization.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center p-5">
                                <p class="lead text-muted">Aucune organisation n'a été trouvée.</p>
                                <a href="{{ path('app_organization_new') }}" class="btn btn-success mt-3">Créer la première organisation</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}