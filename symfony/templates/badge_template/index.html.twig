{% extends 'base.html.twig' %}

{% block title %}BadgeTemplate index{% endblock %}

{% block body %}
    <h1>BadgeTemplate index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>FilePath</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for badge_template in badge_templates %}
            <tr>
                <td>{{ badge_template.id }}</td>
                <td>{{ badge_template.name }}</td>
                <td>{{ badge_template.filePath }}</td>
                <td>{{ badge_template.createdAt ? badge_template.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ badge_template.updatedAt ? badge_template.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_badge_template_show', {'id': badge_template.id}) }}">show</a>
                    <a href="{{ path('app_badge_template_edit', {'id': badge_template.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_badge_template_new') }}">Create new</a>
{% endblock %}
