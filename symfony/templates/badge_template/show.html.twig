{% extends 'base.html.twig' %}

{% block title %}BadgeTemplate{% endblock %}

{% block body %}
    <h1>BadgeTemplate</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ badge_template.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ badge_template.name }}</td>
            </tr>
            <tr>
                <th>FilePath</th>
                <td>{{ badge_template.filePath }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ badge_template.createdAt ? badge_template.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ badge_template.updatedAt ? badge_template.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_badge_template_index') }}">back to list</a>

    <a href="{{ path('app_badge_template_edit', {'id': badge_template.id}) }}">edit</a>

    {{ include('badge_template/_delete_form.html.twig') }}
{% endblock %}
