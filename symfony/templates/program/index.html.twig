{% extends 'base.html.twig' %}

{% block title %}Programmes disponibles{% endblock %}

{% block body %}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">
        <i class="fas fa-calendar-alt me-3"></i>List of programs
    </h1>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th class="text-center">Inscription</th>
                    <th class="text-center">Participants</th>
                </tr>
            </thead>
            <tbody>
            {% for program in programs %}
                <tr>
                    <td>
                        <a href="{{ path('app_program_show', {'id': program.id}) }}">
                            {{ program.title }}
                        </a>
                    </td>
                    <td>{{ program.startDate ? program.startDate|date('d/m/Y') : '' }}</td>
                    <td>{{ program.endDate ? program.endDate|date('d/m/Y') : '' }}</td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-success btn-sm rounded-circle"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#registrationOffcanvas"
                                data-program-id="{{ program.id }}"
                                data-program-title="{{ program.title }}">
                            <i class="fas fa-user-plus"></i>
                        </button>
                    </td>

                    <td class="text-center">
                        <button
                            type="button"
                            class="btn btn-primary btn-view-participants"
                            data-program-id="{{ program.id }}"
                            data-program-title="{{ program.title }}"
                            data-bs-toggle="modal"
                            data-bs-target="#participantsModal">
                            Voir
                        </button>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center py-5">Aucun programme</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>


<!-- =============================== -->
<!-- MODAL : LISTE DES PARTICIPANTS -->
<!-- =============================== -->

<div class="modal fade" id="participantsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="participantsModalTitle">Participants</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="participants-loading" class="text-center text-muted my-5" style="display:none;">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Chargement...
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="participants-table" style="display:none;">
                        <thead>
                            <tr class="table-light">
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Email</th>
                                <th>Pays</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                        <tbody id="participants-tbody">
                        </tbody>
                    </table>
                </div>

                <div id="participants-empty" class="alert alert-info text-center" style="display:none;">
                    Aucun participant pour ce programme.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

{% endblock %}



{% block javascripts %}
{{ parent() }}

<script>
document.addEventListener("DOMContentLoaded", () => {

    // ================================
    // ÉVÉNEMENT : ouverture du modal
    // ================================
    document.querySelectorAll(".btn-view-participants").forEach(btn => {
        btn.addEventListener("click", async () => {
            const programId = btn.dataset.programId;
            const programTitle = btn.dataset.programTitle;



            document.getElementById("participantsModalTitle").textContent =
                "Participants - " + programTitle;

            const loading = document.getElementById("participants-loading");
            const empty = document.getElementById("participants-empty");
            const table = document.getElementById("participants-table");
            const tbody = document.getElementById("participants-tbody");

            // Reset affichage
            loading.style.display = "block";
            empty.style.display = "none";
            table.style.display = "none";
            tbody.innerHTML = "";

            // URL API Symfony
            const url = `program/${programId}/participants`;

            try {
                const response = await fetch(url);
                const data = await response.json();

                loading.style.display = "none";

                if (!data || data.length === 0) {
                    empty.style.display = "block";
                    return;
                }

                table.style.display = "table";

                data.forEach(p => {
                    tbody.innerHTML += `
                        <tr>
                            <td>${p.id}</td>
                            <td>${p.lastName}</td>
                            <td>${p.firstName}</td>
                            <td>${p.email}</td>
                            <td>${p.country ?? ""}</td>
                            <td>${p.participantType ?? ""}</td>
                        </tr>
                    `;
                });

            } catch (e) {
                loading.style.display = "none";
                empty.style.display = "block";
                empty.innerHTML = `Erreur lors du chargement`;
            }
        });
    });

});
</script>

{% endblock %}
