{% extends 'base.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
    <h1>List of events</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Start_date</th>
                <th>End_date</th>
                <th>Start_time</th>
                <th>End_time</th>
            </tr>
        </thead>
        <tbody>
        {% for event in events %}
            <tr> 
                <td>
                    <a href="{{ path('app_event_show', {'id': event.id}) }}">
                        {{ event.title }}
                    </a>
                </td>
                <td>{{ event.startDate ? event.startDate|date('Y-m-d') : '' }}</td>
                <td>{{ event.endDate ? event.endDate|date('Y-m-d') : '' }}</td>
                <td>{{ event.startTime ? event.startTime|date('H:i:s') : '' }}</td>
                <td>{{ event.endTime ? event.endTime|date('H:i:s') : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_event_new') }}">Create new</a>
{% endblock %}
